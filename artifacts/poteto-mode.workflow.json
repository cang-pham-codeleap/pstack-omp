        "id": "playbook-todo-binding",
        "label": "Playbook & Verbatim Todo Binding",
        "focus": ["request", "classify", "todo_sync", "adhoc_gate"],
        "note": "Requests are mapped to playbooks and initialized as verbatim todo items rather than default LLM checklists."
      },
      {
        "id": "governed-execution",
        "label": "Governed Execution & Delegation",
        "focus": ["todo_sync", "principles", "execute_step", "delegate_tier", "surface_verify"],
        "note": "Execution enforces leaf principles, routes through specialized skills, and delegates to tiered model roles."
      },
      {
        "id": "verification-and-ship",
        "label": "Surface Verification & Ship",
        "focus": ["surface_verify", "slop_sweep", "open_pr"],
        "note": "Work is verified on its real control surface before sweeping slop and opening a pull request."
