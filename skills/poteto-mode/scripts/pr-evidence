#!/usr/bin/env bash
# Push PR evidence (screenshots, GIFs, videos) to branch evidence/<current
# branch> and print markdown that references each file by commit-SHA
# permalink. GitHub has no API for PR attachments; a blob permalink with
# ?raw=true renders images inline, but a committed video only shows "View
# raw", so each video also gets a GIF (ffmpeg) that plays in the PR body, with
# the original linked below it. The PR branch itself never carries the files.
# The evidence branch holds only .pr-evidence/: its first commit has no parent,
# so pushing it shares no history with the code and triggers no CI or preview
# deploys. Uses git plumbing only: the caller's worktree, index, and HEAD are
# untouched.
#
# Usage: pr-evidence <file>...   (run in the PR's worktree, on its branch,
# with HEAD pushed as the PR head)
# stdout: a "Captured against" line, then one markdown line per file.
# Progress goes to stderr.
set -euo pipefail

[ $# -ge 1 ] || { echo "usage: pr-evidence <file>..." >&2; exit 1; }
work=$(git branch --show-current)
[ -n "$work" ] || { echo "detached HEAD: check out the PR branch first" >&2; exit 1; }
branch="evidence/$work"
dir=.pr-evidence

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
files=()
names=()
add() {
	local seen
	for seen in ${names[@]+"${names[@]}"}; do
		[ "$seen" != "$2" ] || { echo "duplicate file name: $2 (rename one, e.g. before-$2)" >&2; exit 1; }
	done
	files+=("$1")
	names+=("$2")
}
for f in "$@"; do
	[ -f "$f" ] || { echo "not a file: $f" >&2; exit 1; }
	name=$(basename -- "$f")
	case "$(printf '%s' "${name##*.}" | tr '[:upper:]' '[:lower:]')" in
		mp4|webm|mov|mkv)
			command -v ffmpeg >/dev/null || { echo "ffmpeg is required to turn $name into a GIF" >&2; exit 1; }
			gif="$tmp/${name%.*}.gif"
			echo "converting $name to GIF" >&2
			ffmpeg -v error -y -i "$f" -vf "fps=10,scale='min(960,iw)':-2:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse" "$gif"
			size=$(wc -c <"$gif")
			[ "$size" -le 10000000 ] || echo "warning: $(basename -- "$gif") is $((size / 1000000)) MB; GitHub may not render it inline, so record a shorter clip" >&2
			add "$gif" "$(basename -- "$gif")"
			;;
	esac
	add "$f" "$name"
done

# gh resolves the remote itself, so SSH host aliases work and URL userinfo
# never reaches the output.
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
head=$(git rev-parse HEAD)
pr_head=$(gh pr view --json headRefOid --jq .headRefOid)
[ "$head" = "$pr_head" ] || { echo "local HEAD $head is not the PR head $pr_head; push or pull first" >&2; exit 1; }

export GIT_INDEX_FILE="$tmp/index" # absent until git writes it

parent=()
if git ls-remote --exit-code --heads origin "$branch" >/dev/null; then
	echo "fetching $branch" >&2
	git fetch --quiet origin "+refs/heads/$branch:refs/remotes/origin/$branch"
	parent=(-p "$(git rev-parse "refs/remotes/origin/$branch")")
	git read-tree "${parent[1]}"
else
	echo "creating $branch with no parent" >&2
fi

for i in "${!files[@]}"; do
	blob=$(git hash-object -w -- "${files[$i]}")
	git update-index --add --cacheinfo "100644,$blob,$dir/${names[$i]}"
done
tree=$(git write-tree)

if [ ${#parent[@]} -gt 0 ] && [ "$tree" = "$(git rev-parse "${parent[1]}^{tree}")" ]; then
	sha=${parent[1]}
	echo "no changes; reusing $sha" >&2
else
	sha=$(git commit-tree "$tree" ${parent[@]+"${parent[@]}"} -m "evidence: $work at $head")
	echo "pushing $sha to $branch" >&2
	git push --quiet origin "$sha:refs/heads/$branch" >&2
fi

urlencode() {
	local LC_ALL=C s=$1 out='' c i
	for ((i = 0; i < ${#s}; i++)); do
		c=${s:i:1}
		case $c in
			[A-Za-z0-9._~-]) out+=$c ;;
			*) out+=$(printf '%%%02X' "$(( $(printf '%d' "'$c") & 255 ))") ;;
		esac
	done
	printf '%s' "$out"
}

echo "Captured against \`$head\`."
for name in "${names[@]}"; do
	link="https://github.com/$repo/blob/$sha/$dir/$(urlencode "$name")"
	alt=${name//[\[\]]/}
	case "$(printf '%s' "${name##*.}" | tr '[:upper:]' '[:lower:]')" in
		png|jpg|jpeg|gif|webp) echo "![$alt]($link?raw=true)" ;;
		*) echo "[$alt]($link)" ;;
	esac
done
